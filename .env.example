# Copy this file to .env and fill in real values. Never commit .env.

# Option A: full SQLAlchemy URL
# DATABASE_URL=mysql+mysqlconnector://USER:PASSWORD@localhost:3306/fb_scraper

# Option B: discrete DB settings (used when DATABASE_URL is unset)
DB_USER=your_db_user
DB_PASS=your_db_password
DB_HOST=localhost
DB_PORT=3306
DB_NAME=fb_scraper

# Meta / Facebook login used by Playwright scrapers
FB_USER=your_meta_email@example.com
FB_PASS=your_meta_password

# Email reports (sendNewFanPages.py / sendResume.py)
EMAIL_FROM=you@example.com
EMAIL_TO=ops@example.com,partner@example.com
EMAIL_BCC=
GMAIL_APP_PASSWORD=your_gmail_app_password

# Adminer deep-link templates. Use {kw} and {date} placeholders respectively.
ADMINER_KW_URL_TEMPLATE=https://your-adminer.example/?db=fb_scraper&select=fb_possible_advertisers&where[0][col]=foundFromQuery&where[0][op]=%3D&where[0][val]={kw}&limit=50&text_length=100
ADMINER_ADS_URL_TEMPLATE=https://your-adminer.example/?db=fb_scraper&select=fb_ads_filtered&where[0][col]=date&where[0][op]=%3D&where[0][val]={date}&order[0]=seen_count&desc[0]=1&limit=50&text_length=100
